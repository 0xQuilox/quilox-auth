{
  "name": "quilox-auth",
  "version": "2.0.0",
  "description": "Quilox Auth — secure, configurable authentication & RBAC middleware for Express + Mongoose",
  "repository": {
    "url": "https://github.com/0xQuilox/quilox-auth.git",
    "type": "git"
  },
  "homepage": "https://github.com/0xQuilox/quilox-auth#readme",
  "bugs": {
    "url": "https://github.com/0xQuilox/quilox-auth/issues"
  },
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": "./src/index.js",
    "./middleware/*": "./src/middleware/*.js",
    "./utils/*": "./src/utils/*.js",
    "./models/*": "./src/models/*.js"
  },
  "files": [
    "src/middleware/",
    "src/utils/",
    "src/models/",
    "src/controllers/",
    "src/api/routes/authRoutes.js",
    "src/index.js",
    "src/index.d.ts",
    "src/config/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "enginesStrict": false,
  "license": "MIT",
  "keywords": [
    "quilox",
    "auth",
    "authentication",
    "authorization",
    "middleware",
    "nodejs",
    "expressjs",
    "security",
    "jwt",
    "rbac",
    "bcryptjs",
    "mongoose",
    "joi"
  ],
  "author": "Tajudeen Miftahudeen Akorede",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand --detectOpenHandles",
    "test:watch": "jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "prepare": "husky install || true"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^4.18.0 || ^5.0.0",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.0.0 || ^8.0.0",
    "morgan": "^1.10.1"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0",
    "mongoose": "^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "mongoose": {
      "optional": true
    }
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.5.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.0.0",
    "supertest": "^6.3.4"
  }
}
