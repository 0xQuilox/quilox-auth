#
# Quilox Auth Environment Variables
#

# Application
PORT=3000
NODE_ENV=development

# Database
MONGO_URI=mongodb+srv://myuser:mypassword@cluster0.abc123.mongodb.net/my-express-app?retryWrites=true&w=majority

# JWT - required
JWT_SECRET=your_very_secret_and_long_jwt_secret_key_at_least_32_chars
JWT_EXPIRES_IN=1h

# JWT refresh (optional but recommended; falls back to JWT_SECRET)
JWT_REFRESH_SECRET=your_separate_refresh_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing
BCRYPT_SALT_ROUNDS=10

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# CORS (comma-separated origins or * )
CORS_ORIGIN=*
